# ================= TELEGRAM =================
TG_API_ID=1234567
TG_API_HASH=abcdef1234567890abcdef1234567890
# 3 channel sumber
TG_CHANNELS=@GlobalCryptoResearch,@CryptoWorldUpdates,@TheWolfCrypto
# Untuk deploy cloud: isi dengan hasil `python gen_session.py`
# Kalau jalan di komputer/VPS sendiri, biarkan kosong.
TG_SESSION_STRING=

# ================= BYBIT ====================
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# ================= TRADING ==================
LEVERAGE=10                  # selalu 10x, leverage sinyal diabaikan
ENTRY_EQUITY_PERCENT=25      # margin = 25% dari SISA saldo tiap posisi baru.
                             # Contoh $20: p1=5, p2=3.75, p3=2.81, dst.
                             # Total margin tak pernah melebihi saldo (aman).
TP_COUNT=2                   # TP1 & TP2 saja
RESET_SL_TO_ENTRY=true       # TP1 kena -> SL diset ke harga entry
MAX_DRAWDOWN_PERCENT=50      # bot berhenti kalau equity -50%
MAX_SL_PERCENT=0             # 0 = mati. Isi mis. 8 untuk tolak SL >8%
ALLOW_SL_UPDATE=true         # terima pesan "Set stoploss X"
ENTRY_TIMEOUT_HOURS=12

# ================= KEAMANAN =================
DRY_RUN=true                 # WAJIB true sampai selesai uji coba
REQUIRE_CONFIRM=false
SYMBOL_WHITELIST=
MAX_CONCURRENT_POSITIONS=5
POLL_SECONDS=5

# ================= DASHBOARD ================
DB_PATH=trades.db
DASH_HOST=127.0.0.1
DASH_PORT=8080
